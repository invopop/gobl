{
  "id": "GOBL-BS",
  "package": "bs",
  "subsets": [
    {
      "id": "GOBL-BS-TAX-IDENTITY",
      "object": "tax.Identity",
      "subsets": [
        {
          "guard": "code in [BS]",
          "subsets": [
            {
              "field": "code",
              "assert": [
                {
                  "id": "GOBL-BS-TAX-IDENTITY-01",
                  "desc": "tax id code must be a valid TIN",
                  "tests": "matches ^[0-9]{9}$"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
