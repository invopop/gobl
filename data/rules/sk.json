{
  "id": "GOBL-SK",
  "package": "sk",
  "subsets": [
    {
      "id": "GOBL-SK-ORG-IDENTITY",
      "object": "org.Identity",
      "subsets": [
        {
          "guard": "context: regime in [SK]",
          "subsets": [
            {
              "guard": "type in [ICO]",
              "subsets": [
                {
                  "field": "code",
                  "subsets": [
                    {
                      "guard": "present",
                      "assert": [
                        {
                          "id": "GOBL-SK-ORG-IDENTITY-01",
                          "desc": "identity code for type ICO must be 8 digits",
                          "tests": "matches ^\\d{8}$"
                        }
                      ]
                    },
                    {
                      "guard": "present",
                      "assert": [
                        {
                          "id": "GOBL-SK-ORG-IDENTITY-02",
                          "desc": "identity code for type ICO failed the check digit",
                          "tests": "check digit"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-SK-TAX-IDENTITY",
      "object": "tax.Identity",
      "subsets": [
        {
          "guard": "code in [SK]",
          "subsets": [
            {
              "field": "code",
              "subsets": [
                {
                  "guard": "present",
                  "assert": [
                    {
                      "id": "GOBL-SK-TAX-IDENTITY-01",
                      "desc": "tax identity code for SK must be 10 digits starting with 1-7",
                      "tests": "matches ^[1-7]\\d{9}$"
                    }
                  ]
                },
                {
                  "guard": "present",
                  "assert": [
                    {
                      "id": "GOBL-SK-TAX-IDENTITY-02",
                      "desc": "tax identity code for SK failed the checksum: the 10 digit number must be divisible by 11",
                      "tests": "checksum"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
