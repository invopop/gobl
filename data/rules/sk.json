{
  "id": "GOBL-SK",
  "package": "sk",
  "subsets": [
    {
      "id": "GOBL-SK-BILL-INVOICE",
      "object": "bill.Invoice",
      "subsets": [
        {
          "guard": "context: regime in [SK]",
          "subsets": [
            {
              "field": "supplier",
              "assert": [
                {
                  "id": "GOBL-SK-BILL-INVOICE-01",
                  "desc": "invoice SK supplier must have a tax ID code (DIČ or IČ DPH)",
                  "tests": "has tax ID code"
                },
                {
                  "id": "GOBL-SK-BILL-INVOICE-02",
                  "desc": "invoice SK supplier must have an address with street, locality and code (§ 74 ods. 1 písm. a, column R BT-35, BT-37, BT-38)",
                  "tests": "has postal address"
                }
              ]
            },
            {
              "guard": "not (is simplified)",
              "subsets": [
                {
                  "field": "customer",
                  "assert": [
                    {
                      "id": "GOBL-SK-BILL-INVOICE-03",
                      "desc": "invoice SK customer must have an address with street, locality and code (§ 74 ods. 1 písm. b, column R BT-50, BT-52, BT-53)",
                      "tests": "has postal address"
                    }
                  ]
                }
              ]
            },
            {
              "guard": "currency is not EUR",
              "subsets": [
                {
                  "field": "exchange_rates",
                  "assert": [
                    {
                      "id": "GOBL-SK-BILL-INVOICE-04",
                      "desc": "invoice SK not in EUR must have an exchange rate to EUR to state the VAT in euros (§ 74 ods. 1 písm. i)",
                      "tests": "has rate to EUR"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-SK-ORG-IDENTITY",
      "object": "org.Identity",
      "subsets": [
        {
          "guard": "context: regime in [SK]",
          "subsets": [
            {
              "guard": "has a key in [sk-ico]",
              "subsets": [
                {
                  "field": "code",
                  "assert": [
                    {
                      "id": "GOBL-SK-ORG-IDENTITY-01",
                      "desc": "identity code for key sk-ico (IČO) must be 8 digits",
                      "tests": "matches ^\\d{8}$"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-SK-TAX-IDENTITY",
      "object": "tax.Identity",
      "subsets": [
        {
          "guard": "code in [SK]",
          "subsets": [
            {
              "field": "code",
              "subsets": [
                {
                  "guard": "present",
                  "assert": [
                    {
                      "id": "GOBL-SK-TAX-IDENTITY-01",
                      "desc": "tax identity code for SK must be 10 digits starting with 1-9",
                      "tests": "matches ^[1-9]\\d{9}$"
                    }
                  ]
                },
                {
                  "guard": "present",
                  "assert": [
                    {
                      "id": "GOBL-SK-TAX-IDENTITY-02",
                      "desc": "tax identity code for SK failed the checksum: the 10 digit number must be divisible by 11",
                      "tests": "checksum"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
