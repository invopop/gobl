{
  "id": "GOBL-AU",
  "package": "au",
  "subsets": [
    {
      "id": "GOBL-AU-TAX-IDENTITY",
      "object": "tax.Identity",
      "subsets": [
        {
          "guard": "code in [AU]",
          "subsets": [
            {
              "field": "code",
              "assert": [
                {
                  "id": "GOBL-AU-TAX-IDENTITY-01",
                  "desc": "tax id code must be a valid 11-digit ABN",
                  "tests": "matches ^[0-9]{11}$"
                }
              ],
              "subsets": [
                {
                  "guard": "present",
                  "assert": [
                    {
                      "id": "GOBL-AU-TAX-IDENTITY-02",
                      "desc": "tax id code checksum must be valid",
                      "tests": "valid"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-AU-BILL-INVOICE",
      "object": "bill.Invoice",
      "subsets": [
        {
          "guard": "context: regime in [AU]",
          "subsets": [
            {
              "guard": "invoice type in [standard], and charges GST",
              "subsets": [
                {
                  "field": "supplier",
                  "assert": [
                    {
                      "id": "GOBL-AU-BILL-INVOICE-01",
                      "desc": "invoice supplier must have an ABN when GST is charged",
                      "tests": "has tax ID code"
                    }
                  ]
                }
              ]
            },
            {
              "guard": "invoice type in [standard], and charges GST on A$1,000 or more",
              "subsets": [
                {
                  "field": "customer",
                  "assert": [
                    {
                      "id": "GOBL-AU-BILL-INVOICE-02",
                      "desc": "invoice customer is required when GST is charged on a total of A$1,000 or more",
                      "tests": "present"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
