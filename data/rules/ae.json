{
  "id": "GOBL-AE",
  "package": "ae",
  "subsets": [
    {
      "id": "GOBL-AE-TAX-IDENTITY",
      "object": "tax.Identity",
      "subsets": [
        {
          "guard": "code in [AE]",
          "subsets": [
            {
              "field": "code",
              "subsets": [
                {
                  "guard": "present",
                  "assert": [
                    {
                      "id": "GOBL-AE-TAX-IDENTITY-01",
                      "desc": "UAE tax identity code must be 15 digits starting with 1",
                      "tests": "matches ^1\\d{14}$"
                    }
                  ]
                },
                {
                  "guard": "matches ^1\\d{14}$",
                  "subsets": [
                    {
                      "guard": "present",
                      "assert": [
                        {
                          "id": "GOBL-AE-TAX-IDENTITY-02",
                          "desc": "UAE tax identity code must start with a TIN with a valid check digit",
                          "tests": "valid TIN check digit"
                        }
                      ]
                    },
                    {
                      "guard": "present",
                      "assert": [
                        {
                          "id": "GOBL-AE-TAX-IDENTITY-03",
                          "desc": "UAE tax identity code must start with a TIN whose business identifier is not all zeros",
                          "tests": "TIN business identifier set"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-AE-ORG-IDENTITY",
      "object": "org.Identity",
      "subsets": [
        {
          "guard": "context: regime in [AE]",
          "subsets": [
            {
              "guard": "type in [TIN]",
              "subsets": [
                {
                  "field": "code",
                  "assert": [
                    {
                      "id": "GOBL-AE-ORG-IDENTITY-01",
                      "desc": "UAE TIN must be 10 digits starting with 1",
                      "tests": "matches ^1\\d{9}$"
                    }
                  ],
                  "subsets": [
                    {
                      "guard": "matches ^1\\d{9}$",
                      "subsets": [
                        {
                          "guard": "present",
                          "assert": [
                            {
                              "id": "GOBL-AE-ORG-IDENTITY-02",
                              "desc": "UAE TIN must end in a valid check digit",
                              "tests": "valid TIN check digit"
                            }
                          ]
                        },
                        {
                          "guard": "present",
                          "assert": [
                            {
                              "id": "GOBL-AE-ORG-IDENTITY-04",
                              "desc": "UAE TIN must have a business identifier that is not all zeros",
                              "tests": "TIN business identifier set"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "guard": "type in [EID]",
              "subsets": [
                {
                  "field": "code",
                  "assert": [
                    {
                      "id": "GOBL-AE-ORG-IDENTITY-03",
                      "desc": "Emirates ID number must be 15 digits starting with 784",
                      "tests": "matches ^784\\d{12}$"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
