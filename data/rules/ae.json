{
  "id": "GOBL-AE",
  "package": "ae",
  "subsets": [
    {
      "id": "GOBL-AE-TAX-IDENTITY",
      "object": "tax.Identity",
      "subsets": [
        {
          "guard": "code in [AE]",
          "subsets": [
            {
              "field": "code",
              "subsets": [
                {
                  "guard": "present",
                  "assert": [
                    {
                      "id": "GOBL-AE-TAX-IDENTITY-01",
                      "desc": "invalid UAE tax identity code",
                      "tests": "matches ^\\d{15}$"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-AE-ORG-IDENTITY",
      "object": "org.Identity",
      "subsets": [
        {
          "guard": "context: regime in [AE]",
          "subsets": [
            {
              "guard": "is TIN",
              "subsets": [
                {
                  "field": "code",
                  "assert": [
                    {
                      "id": "GOBL-AE-ORG-IDENTITY-01",
                      "desc": "UAE TIN must be 10 digits",
                      "tests": "matches ^\\d{10}$"
                    }
                  ]
                }
              ]
            },
            {
              "guard": "is Emirates ID",
              "subsets": [
                {
                  "field": "code",
                  "assert": [
                    {
                      "id": "GOBL-AE-ORG-IDENTITY-02",
                      "desc": "Emirates ID number must be 15 digits",
                      "tests": "matches ^\\d{15}$"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
