{
  "id": "GOBL-CO-DIAN",
  "package": "co-dian",
  "guard": "context: addon in [co-dian-v2]",
  "subsets": [
    {
      "id": "GOBL-CO-DIAN-BILL-INVOICE",
      "object": "bill.Invoice",
      "assert": [
        {
          "id": "GOBL-CO-DIAN-BILL-INVOICE-14",
          "desc": "invoice must be in COP or provide exchange rate for conversion",
          "tests": "can convert to [COP]"
        },
        {
          "id": "GOBL-CO-DIAN-BILL-INVOICE-01",
          "desc": "invoice type must be one of standard, credit-note, debit-note, or proforma",
          "tests": "invoice type in [standard, credit-note, debit-note, proforma]"
        }
      ],
      "subsets": [
        {
          "field": "supplier",
          "subsets": [
            {
              "guard": "colombian supplier",
              "subsets": [
                {
                  "field": "addresses",
                  "assert": [
                    {
                      "id": "GOBL-CO-DIAN-BILL-INVOICE-02",
                      "desc": "at least one address is required for Colombian suppliers",
                      "tests": "length between 1 and 0"
                    }
                  ]
                }
              ]
            },
            {
              "guard": "colombian supplier with code",
              "subsets": [
                {
                  "field": "ext",
                  "assert": [
                    {
                      "id": "GOBL-CO-DIAN-BILL-INVOICE-03",
                      "desc": "extension 'co-dian-municipality' is required",
                      "tests": "ext require [co-dian-municipality]"
                    }
                  ]
                }
              ]
            },
            {
              "guard": "colombian supplier",
              "subsets": [
                {
                  "field": "ext",
                  "assert": [
                    {
                      "id": "GOBL-CO-DIAN-BILL-INVOICE-04",
                      "desc": "extension 'co-dian-fiscal-responsibility' is required",
                      "tests": "ext require [co-dian-fiscal-responsibility]"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "guard": "not simplified",
          "subsets": [
            {
              "field": "customer",
              "subsets": [
                {
                  "field": "tax_id",
                  "assert": [
                    {
                      "id": "GOBL-CO-DIAN-BILL-INVOICE-05",
                      "desc": "customer tax ID is required",
                      "tests": "present"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "field": "customer",
          "subsets": [
            {
              "guard": "colombian customer",
              "subsets": [
                {
                  "field": "addresses",
                  "assert": [
                    {
                      "id": "GOBL-CO-DIAN-BILL-INVOICE-06",
                      "desc": "at least one address is required for Colombian customers",
                      "tests": "length between 1 and 0"
                    }
                  ]
                }
              ]
            },
            {
              "guard": "colombian customer with code",
              "subsets": [
                {
                  "field": "ext",
                  "assert": [
                    {
                      "id": "GOBL-CO-DIAN-BILL-INVOICE-07",
                      "desc": "extension 'co-dian-municipality' is required",
                      "tests": "ext require [co-dian-municipality]"
                    }
                  ]
                }
              ]
            },
            {
              "guard": "colombian customer",
              "subsets": [
                {
                  "field": "ext",
                  "assert": [
                    {
                      "id": "GOBL-CO-DIAN-BILL-INVOICE-08",
                      "desc": "extension 'co-dian-fiscal-responsibility' is required",
                      "tests": "ext require [co-dian-fiscal-responsibility]"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "guard": "invoice type in [credit-note, debit-note]",
          "subsets": [
            {
              "field": "preceding",
              "assert": [
                {
                  "id": "GOBL-CO-DIAN-BILL-INVOICE-09",
                  "desc": "preceding documents are required for credit and debit notes",
                  "tests": "present"
                }
              ]
            }
          ]
        },
        {
          "guard": "invoice type in [credit-note]",
          "subsets": [
            {
              "field": "preceding",
              "subsets": [
                {
                  "each": true,
                  "subsets": [
                    {
                      "field": "ext",
                      "assert": [
                        {
                          "id": "GOBL-CO-DIAN-BILL-INVOICE-10",
                          "desc": "extension 'co-dian-credit-code' is required for credit notes",
                          "tests": "ext require [co-dian-credit-code]"
                        }
                      ]
                    },
                    {
                      "field": "reason",
                      "assert": [
                        {
                          "id": "GOBL-CO-DIAN-BILL-INVOICE-12",
                          "desc": "preceding reason is required",
                          "tests": "present"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "guard": "invoice type in [debit-note]",
          "subsets": [
            {
              "field": "preceding",
              "subsets": [
                {
                  "each": true,
                  "subsets": [
                    {
                      "field": "ext",
                      "assert": [
                        {
                          "id": "GOBL-CO-DIAN-BILL-INVOICE-11",
                          "desc": "extension 'co-dian-debit-code' is required for debit notes",
                          "tests": "ext require [co-dian-debit-code]"
                        }
                      ]
                    },
                    {
                      "field": "reason",
                      "assert": [
                        {
                          "id": "GOBL-CO-DIAN-BILL-INVOICE-13",
                          "desc": "preceding reason is required",
                          "tests": "present"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "field": "code",
          "assert": [
            {
              "id": "GOBL-CO-DIAN-BILL-INVOICE-15",
              "desc": "invoice code must be a positive integer without leading zeroes",
              "tests": "matches ^[1-9][0-9]*$"
            }
          ]
        },
        {
          "guard": "invoice type in [credit-note]",
          "subsets": [
            {
              "field": "preceding",
              "subsets": [
                {
                  "each": true,
                  "subsets": [
                    {
                      "guard": "missing dian-cude stamp",
                      "subsets": [
                        {
                          "field": "ext",
                          "assert": [
                            {
                              "id": "GOBL-CO-DIAN-BILL-INVOICE-16",
                              "desc": "extension 'co-dian-credit-code' cannot be '2' (revoked) without a 'dian-cude' stamp",
                              "tests": "ext 'co-dian-credit-code' not in [2]"
                            }
                          ]
                        },
                        {
                          "field": "period",
                          "assert": [
                            {
                              "id": "GOBL-CO-DIAN-BILL-INVOICE-17",
                              "desc": "period must be within a single calendar month without a 'dian-cude' stamp",
                              "tests": "single calendar month"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "guard": "invoice type in [standard, credit-note, debit-note]",
          "assert": [
            {
              "id": "GOBL-CO-DIAN-BILL-INVOICE-18",
              "desc": "payment due date is required when the invoice is not fully paid",
              "tests": "credit sale has due date"
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-CO-DIAN-BILL-LINE",
      "object": "bill.Line",
      "subsets": [
        {
          "field": "quantity",
          "assert": [
            {
              "id": "GOBL-CO-DIAN-BILL-LINE-01",
              "desc": "must be greater than 0",
              "tests": "min 0"
            }
          ]
        }
      ]
    }
  ]
}
