{
  "id": "GOBL-PE",
  "package": "pe",
  "subsets": [
    {
      "id": "GOBL-PE-TAX-IDENTITY",
      "object": "tax.Identity",
      "subsets": [
        {
          "guard": "code in [PE]",
          "subsets": [
            {
              "field": "code",
              "subsets": [
                {
                  "guard": "present",
                  "assert": [
                    {
                      "id": "GOBL-PE-TAX-IDENTITY-01",
                      "desc": "invalid Peruvian RUC",
                      "tests": "valid mod-11 RUC"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-PE-ORG-IDENTITY",
      "object": "org.Identity",
      "subsets": [
        {
          "guard": "context: regime in [PE]",
          "subsets": [
            {
              "guard": "type in [DNI]",
              "subsets": [
                {
                  "field": "code",
                  "assert": [
                    {
                      "id": "GOBL-PE-ORG-IDENTITY-01",
                      "desc": "invalid DNI",
                      "tests": "valid 8-digit DNI"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-PE-BILL-INVOICE",
      "object": "bill.Invoice",
      "subsets": [
        {
          "guard": "context: regime in [PE]",
          "subsets": [
            {
              "field": "supplier",
              "assert": [
                {
                  "id": "GOBL-PE-BILL-INVOICE-01",
                  "desc": "invoice supplier tax ID code required for Peruvian regime",
                  "tests": "has tax ID code"
                }
              ],
              "subsets": [
                {
                  "field": "tax_id",
                  "subsets": [
                    {
                      "field": "country",
                      "assert": [
                        {
                          "id": "GOBL-PE-BILL-INVOICE-02",
                          "desc": "invoice supplier tax ID country must be PE for Peruvian regime",
                          "tests": "one of [PE]"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
