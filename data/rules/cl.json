{
  "id": "GOBL-CL",
  "package": "cl",
  "subsets": [
    {
      "id": "GOBL-CL-TAX-IDENTITY",
      "object": "tax.Identity",
      "subsets": [
        {
          "guard": "code in [CL]",
          "subsets": [
            {
              "field": "code",
              "subsets": [
                {
                  "guard": "present",
                  "assert": [
                    {
                      "id": "GOBL-CL-TAX-IDENTITY-01",
                      "desc": "invalid Chilean RUT",
                      "tests": "valid mod-11 RUT"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-CL-BILL-INVOICE",
      "object": "bill.Invoice",
      "subsets": [
        {
          "guard": "context: regime in [CL]",
          "subsets": [
            {
              "field": "supplier",
              "assert": [
                {
                  "id": "GOBL-CL-BILL-INVOICE-01",
                  "desc": "invoice supplier tax ID code required for Chilean regime",
                  "tests": "has tax ID code"
                }
              ],
              "subsets": [
                {
                  "field": "tax_id",
                  "subsets": [
                    {
                      "field": "country",
                      "assert": [
                        {
                          "id": "GOBL-CL-BILL-INVOICE-02",
                          "desc": "invoice supplier tax ID country must be CL for Chilean regime",
                          "tests": "one of [CL]"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "guard": "not simplified",
              "subsets": [
                {
                  "field": "customer",
                  "assert": [
                    {
                      "id": "GOBL-CL-BILL-INVOICE-03",
                      "desc": "invoice customer tax ID code required for Chilean regime",
                      "tests": "has tax ID code"
                    }
                  ]
                }
              ]
            },
            {
              "guard": "invoice type in [credit-note, debit-note]",
              "assert": [
                {
                  "id": "GOBL-CL-BILL-INVOICE-04",
                  "desc": "credit and debit notes cannot be simplified invoices for Chilean regime",
                  "tests": "not simplified"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
