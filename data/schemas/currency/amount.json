{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobl.org/draft-0/currency/amount",
  "$ref": "#/$defs/currency.Amount",
  "$defs": {
    "currency.Amount": {
      "properties": {
        "label": {
          "type": "string",
          "title": "Label",
          "description": "Additional information about the amount that may be useful."
        },
        "currency": {
          "$ref": "https://gobl.org/draft-0/currency/code",
          "title": "Currency",
          "description": "Currency of the amount."
        },
        "value": {
          "$ref": "https://gobl.org/draft-0/num/amount",
          "title": "Value",
          "description": "Amount in the currency."
        }
      },
      "type": "object",
      "required": [
        "currency",
        "value"
      ],
      "description": "An Amount represents a monetary value in a specific currency."
    }
  }
}