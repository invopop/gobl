{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobl.org/draft-0/tax/total",
  "$ref": "#/$defs/tax.Total",
  "$defs": {
    "tax.CategoryTotal": {
      "properties": {
        "code": {
          "$ref": "https://gobl.org/draft-0/cbc/code",
          "title": "Code"
        },
        "retained": {
          "type": "boolean",
          "title": "Retained"
        },
        "informative": {
          "type": "boolean",
          "title": "Informative"
        },
        "rates": {
          "items": {
            "$ref": "https://gobl.org/draft-0/tax/rate-total"
          },
          "type": "array",
          "title": "Rates"
        },
        "amount": {
          "$ref": "https://gobl.org/draft-0/num/amount",
          "title": "Amount"
        },
        "surcharge": {
          "$ref": "https://gobl.org/draft-0/num/amount",
          "title": "Surcharge"
        }
      },
      "type": "object",
      "required": [
        "code",
        "rates",
        "amount"
      ],
      "description": "CategoryTotal groups together all rates inside a given category."
    },
    "tax.Total": {
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/tax.CategoryTotal"
          },
          "type": "array",
          "title": "Categories",
          "description": "Grouping of all the taxes by their category."
        },
        "sum": {
          "$ref": "https://gobl.org/draft-0/num/amount",
          "title": "Sum",
          "description": "Total value of all non-retained or indirect taxes."
        },
        "retained": {
          "$ref": "https://gobl.org/draft-0/num/amount",
          "title": "Retained",
          "description": "Sum of retained or withheld tax amounts."
        }
      },
      "type": "object",
      "required": [
        "sum"
      ],
      "description": "Total contains a set of Category Totals which in turn contain all the accumulated taxes contained in the document."
    }
  }
}