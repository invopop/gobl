{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobl.org/draft-0/legal/contract",
  "$ref": "#/$defs/legal.Contract",
  "$defs": {
    "legal.Contract": {
      "properties": {
        "uuid": {
          "type": "string",
          "format": "uuid",
          "title": "UUID",
          "description": "Universally Unique Identifier."
        },
        "title": {
          "type": "string",
          "title": "Title",
          "description": "Title of the document"
        },
        "sub_title": {
          "type": "string",
          "title": "Sub Title",
          "description": "Sub-title"
        },
        "description": {
          "type": "string",
          "title": "Description",
          "description": "Brief summary reflecting on the contents."
        },
        "chapters": {
          "items": {
            "$ref": "https://gobl.org/draft-0/legal/chapter"
          },
          "type": "array",
          "title": "Chapters",
          "description": "Set of chapters that make up the contract."
        }
      },
      "type": "object",
      "required": [
        "title"
      ],
      "description": "Contract represents the structured body of a legal document."
    }
  }
}