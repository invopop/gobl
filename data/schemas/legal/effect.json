{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobl.org/draft-0/legal/effect",
  "$ref": "#/$defs/legal.Effect",
  "$defs": {
    "legal.Effect": {
      "properties": {
        "start": {
          "$ref": "https://gobl.org/draft-0/cal/date",
          "title": "Start Date"
        },
        "end": {
          "$ref": "https://gobl.org/draft-0/cal/date",
          "title": "End Date"
        },
        "trigger": {
          "type": "string",
          "title": "Trigger"
        }
      },
      "type": "object",
      "description": "Effect describes when a contract starts and ceases to have effect."
    }
  }
}